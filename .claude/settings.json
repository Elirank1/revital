{
  "env": { "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1" },
  "permissions": {
    "allow": [
      "Read(**)", "Edit(**)", "Write(**)", "Glob(**)", "Grep(**)",
      "Bash(npm install:*)", "Bash(npm run:*)", "Bash(npm test:*)",
      "Bash(npx vitest:*)", "Bash(npx playwright:*)", "Bash(npx tsc:*)",
      "Bash(node:*)", "Bash(mkdir:*)", "Bash(ls:*)", "Bash(cat:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git branch:*)",
      "Bash(git checkout:*)", "Bash(git stash:*)",
      "Bash(git push origin v3-jump:*)",
      "Bash(cp:*)", "Bash(mv:*)", "Bash(chmod:*)", "Bash(npx supabase:*)",
      "WebFetch(domain:code.claude.com)", "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:supabase.com)", "WebFetch(domain:vercel.com)"
    ],
    "deny": [
      "Bash(vercel:*)", "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "TaskCompleted": [ { "hooks": [ { "type": "command", "command": "bash .claude/hooks/gate-task-completed.sh", "timeout": 300 } ] } ],
    "TeammateIdle":  [ { "hooks": [ { "type": "command", "command": "bash .claude/hooks/gate-teammate-idle.sh",  "timeout": 30  } ] } ]
  }
}
